# News runtime defaults stay off. Use a private env file for live Naver/OpenAI smoke.
HOME_NEWS_ENABLED=false
HOME_NEWS_RUN_ONCE_ENABLED=false
HOME_NEWS_RUN_ONCE_QUERY_TEXT=
HOME_NEWS_RUN_ONCE_MAX_KEYWORDS=1
HOME_NEWS_RUN_ONCE_MAX_ARTICLES=10
HOME_NEWS_NAVER_DISPLAY=10
HOME_NEWS_NAVER_SORT=date
HOME_NEWS_OPENAI_EXTRACTION_VERSION=naver-title-snippet-v1
HOME_NEWS_OPENAI_PROMPT_VERSION=news-signal-v1
HOME_NEWS_OPENAI_SCHEMA_VERSION=news-signal-json-v1
HOME_NEWS_RESEARCH_SEED_ENABLED=false
HOME_NEWS_RESEARCH_SEED_MODE=GENERATE_CSV_SHORTLIST
HOME_NEWS_RESEARCH_SEED_PERIOD_START=2020-06-01
HOME_NEWS_RESEARCH_SEED_PERIOD_END=2020-06-30
HOME_NEWS_RESEARCH_SEED_CSV_INPUT_DIR=apps/news/local-input/historical-news-csv
HOME_NEWS_RESEARCH_SEED_CSV_SHORTLIST_LIMIT=20

# Local DB example. Override these in a private env file for your local Postgres.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:15432/home_search
SPRING_DATASOURCE_USERNAME=home_search
SPRING_DATASOURCE_PASSWORD=home_search
