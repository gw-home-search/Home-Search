{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://home-search.internal/events/DatasetActivated/v1",
  "title": "DatasetActivated v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "producer", "aggregateType", "aggregateId", "aggregateVersion", "correlationId", "causationId", "traceId", "payload"],
  "properties": {
    "eventId": {"type": "string", "format": "uuid"},
    "eventType": {"type": "string", "const": "DatasetActivated"},
    "schemaVersion": {"type": "integer", "const": 1},
    "occurredAt": {"type": "string", "format": "date-time"},
    "producer": {"type": "string", "const": "ai-service"},
    "aggregateType": {"type": "string", "const": "DatasetVersion"},
    "aggregateId": {"type": "string", "pattern": "[A-Za-z0-9._:-]{1,128}", "maxLength": 128},
    "aggregateVersion": {"type": "integer", "minimum": 1},
    "correlationId": {"type": "string", "maxLength": 128},
    "causationId": {"type": ["string", "null"], "maxLength": 128},
    "traceId": {"type": "string", "pattern": "[A-Za-z0-9._:-]{1,128}", "maxLength": 128},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datasetVersionId", "datasetType", "checksumSha256"],
      "properties": {
        "datasetVersionId": {"type": "string", "format": "uuid"},
        "datasetType": {"type": "string", "enum": ["SCHOOL", "CHILDCARE", "ACADEMY", "RAIL", "RETAIL", "LEGAL"]},
        "checksumSha256": {"type": "string", "pattern": "[0-9a-f]{64}"}
      }
    }
  }
}
