{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://home-search.internal/events/EmailRequested/v1",
  "title": "EmailRequested v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "producer", "aggregateType", "aggregateId", "aggregateVersion", "correlationId", "causationId", "traceId", "payload"],
  "properties": {
    "eventId": {"type": "string", "format": "uuid"},
    "eventType": {"type": "string", "const": "EmailRequested"},
    "schemaVersion": {"type": "integer", "const": 1},
    "occurredAt": {"type": "string", "format": "date-time"},
    "producer": {"type": "string", "const": "user-service"},
    "aggregateType": {"type": "string", "const": "Delivery"},
    "aggregateId": {"type": "string", "pattern": "[A-Za-z0-9._:-]{1,128}", "maxLength": 128},
    "aggregateVersion": {"type": "integer", "minimum": 1},
    "correlationId": {"type": "string", "maxLength": 128},
    "causationId": {"type": ["string", "null"], "maxLength": 128},
    "traceId": {"type": "string", "pattern": "[A-Za-z0-9._:-]{1,128}", "maxLength": 128},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deliveryId", "userId", "digestId", "consentVersion"],
      "properties": {
        "deliveryId": {"type": "string", "format": "uuid"},
        "userId": {"type": "string", "pattern": "[A-Za-z0-9._:-]{1,128}"},
        "digestId": {"type": "string", "format": "uuid"},
        "consentVersion": {"type": "integer", "minimum": 1}
      }
    }
  }
}
