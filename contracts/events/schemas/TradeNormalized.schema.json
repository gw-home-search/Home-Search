{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://home-search.internal/events/TradeNormalized/v1",
  "title": "TradeNormalized v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "producer", "aggregateType", "aggregateId", "aggregateVersion", "correlationId", "causationId", "traceId", "payload"],
  "properties": {
    "eventId": {"type": "string", "format": "uuid"},
    "eventType": {"type": "string", "const": "TradeNormalized"},
    "schemaVersion": {"type": "integer", "const": 1},
    "occurredAt": {"type": "string", "format": "date-time"},
    "producer": {"type": "string", "const": "property-data"},
    "aggregateType": {"type": "string", "const": "Trade"},
    "aggregateId": {"type": "string", "pattern": "[A-Za-z0-9._:-]{1,128}", "maxLength": 128},
    "aggregateVersion": {"type": "integer", "minimum": 1},
    "correlationId": {"type": "string", "maxLength": 128},
    "causationId": {"type": ["string", "null"], "maxLength": 128},
    "traceId": {"type": "string", "pattern": "[A-Za-z0-9._:-]{1,128}", "maxLength": 128},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tradeId", "complexId", "dealDate", "dealAmount", "exclArea", "tradeStatus"],
      "properties": {
        "tradeId": {"type": "string", "pattern": "[A-Za-z0-9._:-]{1,128}"},
        "complexId": {"type": "integer", "minimum": 1},
        "dealDate": {"type": "string", "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}"},
        "dealAmount": {"type": "integer", "minimum": 0},
        "exclArea": {"type": "number", "minimum": 0},
        "tradeStatus": {"type": "string", "enum": ["ACTIVE"]}
      }
    }
  }
}
