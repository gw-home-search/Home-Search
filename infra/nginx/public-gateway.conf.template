map $request_method $public_rate_limit_key {
    default $binary_remote_addr;
    OPTIONS "";
}

map $http_x_forwarded_proto $external_forwarded_proto {
    default $scheme;
    https https;
    http http;
}

limit_req_zone $public_rate_limit_key zone=nearby_place_per_ip:10m rate=5r/s;
limit_req_zone $public_rate_limit_key zone=map_bbox_per_ip:10m rate=10r/s;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    limit_req_status 429;
    client_max_body_size 1m;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://dapi.kakao.com https://t1.daumcdn.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.daumcdn.net https://*.kakaocdn.net; connect-src 'self' https://dapi.kakao.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self)" always;
    error_page 429 = @ingress_rate_limit_problem;

    location @ingress_rate_limit_problem {
        internal;
        default_type application/problem+json;
        add_header Cache-Control "no-store" always;
        add_header Retry-After "1" always;
        return 429 '{"type":"/docs/index.html#error-code-list","title":"Too Many Requests","status":429,"detail":"Too many requests.","exception":"IngressRateLimitException","timestamp":"$time_iso8601"}';
    }

    location = /internal { return 404; }
    location ^~ /internal/ { return 404; }
    location = /api/v1/admin { return 404; }
    location ^~ /api/v1/admin/ { return 404; }
    location = /actuator { return 404; }
    location ^~ /actuator/ { return 404; }

    location ~ ^/(?:auth/(?:access|logout)|oauth2/authorization/|login/oauth2/code/) {
        proxy_pass http://${USER_API_HOST}:${USER_API_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Request-Id $http_x_request_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $external_forwarded_proto;
    }

    location ~ ^/api/v1/(?:users(?:/|$)|favorites(?:/|$)) {
        proxy_pass http://${USER_API_HOST}:${USER_API_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Request-Id $http_x_request_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $external_forwarded_proto;
    }

    location = /api/v1/insights/subscription {
        proxy_pass http://${USER_API_HOST}:${USER_API_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Request-Id $http_x_request_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $external_forwarded_proto;
    }

    location = /api/v1/insights/inbox {
        proxy_pass http://${USER_API_HOST}:${USER_API_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Request-Id $http_x_request_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $external_forwarded_proto;
    }

    location = /api/v1/insights/trades/latest {
        proxy_pass http://${PROPERTY_API_HOST}:${PROPERTY_API_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Request-Id $http_x_request_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $external_forwarded_proto;
    }

    location = /api/v1/insights/trades/weekly {
        proxy_pass http://${PROPERTY_API_HOST}:${PROPERTY_API_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Request-Id $http_x_request_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $external_forwarded_proto;
    }

    location = /api/v1/insights/trends {
        proxy_pass http://${PROPERTY_API_HOST}:${PROPERTY_API_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Request-Id $http_x_request_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $external_forwarded_proto;
    }

    location = /api/v1/insights/news {
        proxy_pass http://${PROPERTY_API_HOST}:${PROPERTY_API_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Request-Id $http_x_request_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $external_forwarded_proto;
    }

    location = /api/v1/insights { return 404; }
    location ^~ /api/v1/insights/ { return 404; }
    location = /api/v1/chatbot { return 404; }

    location = /api/v1/chatbot/query {
        client_max_body_size 64k;
        proxy_pass http://${CHAT_BFF_HOST}:${CHAT_BFF_PORT};
        proxy_http_version 1.1;
        proxy_connect_timeout 5s;
        proxy_send_timeout 70s;
        proxy_read_timeout 70s;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Request-Id $http_x_request_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $external_forwarded_proto;
    }

    location = /api/v1/chatbot/query/stream {
        client_max_body_size 64k;
        proxy_pass http://${CHAT_BFF_HOST}:${CHAT_BFF_PORT};
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_connect_timeout 5s;
        proxy_send_timeout 70s;
        proxy_read_timeout 70s;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Request-Id $http_x_request_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $external_forwarded_proto;
    }

    location ^~ /api/v1/chatbot/ { return 404; }

    location ~ "^/api/v1/complex/[^/]+/nearby-places(?:$|[;/])" {
        limit_req zone=nearby_place_per_ip burst=10 nodelay;
        proxy_pass http://${PROPERTY_API_HOST}:${PROPERTY_API_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Request-Id $http_x_request_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $external_forwarded_proto;
    }

    location ~ ^/api/v1/map/(?:regions|complexes)$ {
        limit_req zone=map_bbox_per_ip burst=30 nodelay;
        proxy_pass http://${PROPERTY_API_HOST}:${PROPERTY_API_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Request-Id $http_x_request_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $external_forwarded_proto;
    }

    location ~ "^/api/v1/map/nearby-places(?:$|[;/])" {
        limit_req zone=nearby_place_per_ip burst=10 nodelay;
        proxy_pass http://${PROPERTY_API_HOST}:${PROPERTY_API_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Request-Id $http_x_request_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $external_forwarded_proto;
    }

    location /api/ {
        proxy_pass http://${PROPERTY_API_HOST}:${PROPERTY_API_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Request-Id $http_x_request_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $external_forwarded_proto;
    }

    location ^~ /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
