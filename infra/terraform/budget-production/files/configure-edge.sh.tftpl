#!/usr/bin/env bash
set -Eeuo pipefail
set +x
umask 077

readonly CERTIFICATE_ARN='${certificate_arn}'
readonly PASSPHRASE_PARAMETER='${passphrase_parameter}'
readonly PUBLIC_HOSTNAME='${public_hostname}'
readonly CERTIFICATE_DIRECTORY='/etc/home-search/tls'
readonly RUNTIME_DIRECTORY='/srv/home-search/runtime'

temporary_directory="$(mktemp -d /tmp/home-search-edge.XXXXXX)"
cleanup() { find "$${temporary_directory}" -depth -delete 2>/dev/null || true; }
trap cleanup EXIT HUP INT TERM

dnf install -y nginx jq openssl >/dev/null
install -d -m 0700 -o root -g root "$${CERTIFICATE_DIRECTORY}"
install -d -m 0750 -o root -g root "$${RUNTIME_DIRECTORY}"

aws ssm get-parameter \
  --name "$${PASSPHRASE_PARAMETER}" \
  --with-decryption \
  --query 'Parameter.Value' \
  --output text \
  --region ap-northeast-2 >"$${temporary_directory}/passphrase"
if grep -qx 'UNSET' "$${temporary_directory}/passphrase"; then
  echo 'refusing certificate export: passphrase parameter is not configured' >&2
  exit 1
fi

aws acm export-certificate \
  --certificate-arn "$${CERTIFICATE_ARN}" \
  --passphrase "fileb://$${temporary_directory}/passphrase" \
  --region ap-northeast-2 >"$${temporary_directory}/certificate.json"

jq -er '.Certificate' "$${temporary_directory}/certificate.json" >"$${temporary_directory}/certificate.pem"
jq -er '.CertificateChain' "$${temporary_directory}/certificate.json" >>"$${temporary_directory}/certificate.pem"
jq -er '.PrivateKey' "$${temporary_directory}/certificate.json" >"$${temporary_directory}/encrypted-private-key.pem"
openssl x509 -in "$${temporary_directory}/certificate.pem" -noout -checkend 604800 >/dev/null
openssl pkey \
  -passin "file:$${temporary_directory}/passphrase" \
  -in "$${temporary_directory}/encrypted-private-key.pem" \
  -out "$${temporary_directory}/private-key.pem" >/dev/null 2>&1
openssl pkey -in "$${temporary_directory}/private-key.pem" -noout -check >/dev/null 2>&1
install -m 0400 -o root -g root "$${temporary_directory}/certificate.pem" "$${CERTIFICATE_DIRECTORY}/certificate.pem"
install -m 0400 -o root -g root "$${temporary_directory}/private-key.pem" "$${CERTIFICATE_DIRECTORY}/private-key.pem"

cat >/etc/nginx/conf.d/home-search.conf <<NGINX
log_format home_search_json escape=json '{"timestamp":"\$time_iso8601","remote_addr":"\$remote_addr","method":"\$request_method","uri":"\$uri","status":\$status,"bytes":\$body_bytes_sent,"request_time":\$request_time,"upstream_time":"\$upstream_response_time","request_id":"\$request_id"}';
access_log /var/log/nginx/home-search-access.json home_search_json;

server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 443 ssl default_server;
    server_name _;
    ssl_certificate $${CERTIFICATE_DIRECTORY}/certificate.pem;
    ssl_certificate_key $${CERTIFICATE_DIRECTORY}/private-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    return 444;
}

server {
    listen 80;
    server_name $${PUBLIC_HOSTNAME};
    return 308 https://\$host\$request_uri;
}

server {
    listen 443 ssl;
    server_name $${PUBLIC_HOSTNAME};
    ssl_certificate $${CERTIFICATE_DIRECTORY}/certificate.pem;
    ssl_certificate_key $${CERTIFICATE_DIRECTORY}/private-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    client_max_body_size 1m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self)" always;

    location = /api/v1/chatbot/query {
        if (-f $${RUNTIME_DIRECTORY}/chatbot-drain) { return 503; }
        proxy_pass http://127.0.0.1:18000;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_read_timeout 75s;
        proxy_set_header Host \$host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-Id \$request_id;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    }

    location = /api/v1/chatbot/query/stream {
        if (-f $${RUNTIME_DIRECTORY}/chatbot-drain) { return 503; }
        proxy_pass http://127.0.0.1:18000;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 75s;
        proxy_set_header Connection "";
        proxy_set_header Host \$host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-Id \$request_id;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    }

    location / {
        proxy_pass http://127.0.0.1:18000;
        proxy_http_version 1.1;
        proxy_connect_timeout 5s;
        proxy_read_timeout 75s;
        proxy_set_header Host \$host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-Id \$request_id;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    }
}

server {
    listen 127.0.0.1:18090;
    server_name localhost;
    access_log off;
    location = /health { return 200 'ok'; add_header Content-Type text/plain; }
    location / { return 404; }
}
NGINX

rm -f /etc/nginx/conf.d/default.conf
nginx -t
systemctl enable nginx
systemctl reload nginx 2>/dev/null || systemctl restart nginx
echo 'edge configuration and certificate reload completed'
