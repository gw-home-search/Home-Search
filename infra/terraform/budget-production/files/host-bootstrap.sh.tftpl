#!/usr/bin/env bash
set -euo pipefail

readonly EXPECTED_VOLUME_ID='${data_volume_id}'
readonly EXPECTED_AZ='${availability_zone}'
readonly MOUNT_POINT='/srv/home-search'

imds_token="$(curl --fail --silent --show-error --request PUT \
  --header 'X-aws-ec2-metadata-token-ttl-seconds: 300' \
  http://169.254.169.254/latest/api/token)"
actual_az="$(curl --fail --silent --show-error \
  --header "X-aws-ec2-metadata-token: $${imds_token}" \
  http://169.254.169.254/latest/meta-data/placement/availability-zone)"
test "$${actual_az}" = "$${EXPECTED_AZ}" || {
  echo "refusing data mount: instance AZ mismatch" >&2
  exit 1
}

volume_az="$(aws ec2 describe-volumes \
  --volume-ids "$${EXPECTED_VOLUME_ID}" \
  --query 'Volumes[0].AvailabilityZone' \
  --output text \
  --region ap-northeast-2)"
test "$${volume_az}" = "$${EXPECTED_AZ}" || {
  echo "refusing data mount: EBS AZ mismatch" >&2
  exit 1
}

expected_serial="$${EXPECTED_VOLUME_ID//-/}"
device=''
for _ in $(seq 1 90); do
  device="$(lsblk --nodeps --noheadings --output PATH,SERIAL 2>/dev/null \
    | awk -v serial="$${expected_serial}" '$2 == serial {print $1; exit}')"
  test -n "$${device}" && break
  sleep 2
done
test -b "$${device}" || {
  echo "refusing data mount: expected EBS device not found" >&2
  exit 1
}

filesystem_type="$(blkid -o value -s TYPE "$${device}" 2>/dev/null || true)"
if test -z "$${filesystem_type}"; then
  if test -n "$(wipefs --noheadings "$${device}" 2>/dev/null)"; then
    echo "refusing data mount: unrecognized signatures exist" >&2
    exit 1
  fi
  mkfs.xfs "$${device}"
  filesystem_type='xfs'
fi
test "$${filesystem_type}" = 'xfs' || {
  echo "refusing data mount: filesystem must be XFS" >&2
  exit 1
}

filesystem_uuid="$(blkid -o value -s UUID "$${device}")"
test -n "$${filesystem_uuid}" || {
  echo "refusing data mount: filesystem UUID is missing" >&2
  exit 1
}

mkdir -p "$${MOUNT_POINT}"
mounted_source="$(findmnt --noheadings --output SOURCE --target "$${MOUNT_POINT}" 2>/dev/null || true)"
if test -n "$${mounted_source}"; then
  mounted_uuid="$(blkid -o value -s UUID "$${mounted_source}" 2>/dev/null || true)"
  test "$${mounted_uuid}" = "$${filesystem_uuid}" || {
    echo "refusing data mount: mount point uses an unexpected filesystem" >&2
    exit 1
  }
else
  existing_target="$(findmnt --noheadings --output TARGET --source "$${device}" 2>/dev/null || true)"
  test -z "$${existing_target}" || {
    echo "refusing data mount: expected EBS device is mounted elsewhere" >&2
    exit 1
  }
  mount -o defaults "UUID=$${filesystem_uuid}" "$${MOUNT_POINT}"
fi
grep -q "UUID=$${filesystem_uuid}" /etc/fstab || \
  printf 'UUID=%s %s xfs defaults 0 2\n' "$${filesystem_uuid}" "$${MOUNT_POINT}" >> /etc/fstab

install -d -m 0700 -o 70 -g 70 "$${MOUNT_POINT}/postgres"
install -d -m 0700 -o 999 -g 1000 "$${MOUNT_POINT}/valkey"
install -d -m 0750 -o root -g root "$${MOUNT_POINT}/backup-staging"
install -d -m 0750 -o root -g root "$${MOUNT_POINT}/runtime"
install -d -m 0700 -o 70 -g 70 "$${MOUNT_POINT}/runtime/postgres-tls"
install -d -m 0750 -o 10001 -g 10001 "$${MOUNT_POINT}/runtime/ml-model"

systemctl stop ecs || true
systemctl stop docker || true
install -d -m 0755 /etc/docker /etc/ecs \
  /etc/systemd/system/docker.service.d /etc/systemd/system/ecs.service.d
for service in docker ecs; do
  cat >"/etc/systemd/system/$${service}.service.d/home-search-data-mount.conf" <<'UNIT'
[Unit]
RequiresMountsFor=/srv/home-search
ConditionPathIsMountPoint=/srv/home-search
UNIT
done
cat >/etc/docker/daemon.json <<'JSON'
{
  "bip": "172.31.255.1/24",
  "icc": true,
  "live-restore": true,
  "log-driver": "awslogs"
}
JSON
cat >/etc/ecs/ecs.config <<'ECS'
ECS_CLUSTER=${cluster_name}
ECS_ENABLE_CONTAINER_METADATA=true
ECS_ENGINE_TASK_CLEANUP_WAIT_DURATION=30m
ECS_IMAGE_CLEANUP_INTERVAL=30m
ECS_IMAGE_MINIMUM_CLEANUP_AGE=1h
ECS_NUM_IMAGES_DELETE_PER_CYCLE=5
ECS

cat >/usr/local/sbin/home-search-docker-guard <<'GUARD'
#!/usr/bin/env bash
set -euo pipefail
iptables -C DOCKER-USER -d 169.254.169.254/32 -j REJECT 2>/dev/null || \
  iptables -I DOCKER-USER 1 -d 169.254.169.254/32 -j REJECT
GUARD
chmod 0755 /usr/local/sbin/home-search-docker-guard
cat >/etc/systemd/system/home-search-docker-guard.service <<'UNIT'
[Unit]
Description=Block ECS bridge containers from EC2 instance metadata
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/home-search-docker-guard
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable home-search-docker-guard.service
systemctl restart docker
systemctl restart ecs
systemctl start home-search-docker-guard.service
